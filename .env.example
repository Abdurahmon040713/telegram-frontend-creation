# ─────────────────────────────────────────────────────────────────────────────
# CHATSPHERE  —  Frontend (Next.js) environment variables
# Ko'chirish:  copy .env.example .env.local   va qiymatlarni to'ldiring
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-side (brauzerga chiqmaydi) ────────────────────────────────────────
# Next.js API routes → FastAPI backend manzili
BACKEND_URL=http://localhost:8001

# Backend dagi JWT_SECRET_KEY bilan bir xil qiymat bo'lishi SHART
JWT_SECRET_KEY=SAME_VALUE_AS_BACKEND_JWT_SECRET_KEY

# ── Public (brauzerga chiqadi) ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HttpOnly cookie Secure flag (HTTP dev: false, HTTPS prod: true)
COOKIE_SECURE=false
